{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joyagent.local/schemas/agent-runtime-profile-v2.schema.json",
  "title": "Agent Runtime Profile V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agentId",
    "agentVersion",
    "name",
    "description",
    "compiledSystemPromptTemplate",
    "resolvedModelName",
    "skills",
    "capabilityKeys"
  ],
  "properties": {
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "agentVersion": {
      "type": "integer",
      "minimum": 0
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "compiledSystemPromptTemplate": {
      "type": "string"
    },
    "resolvedModelName": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skillId",
          "skillVersion",
          "sortOrder",
          "instruction",
          "outputRequirement"
        ],
        "properties": {
          "skillId": { "type": "string", "minLength": 1 },
          "skillVersion": { "type": "integer", "minimum": 0 },
          "sortOrder": { "type": "integer", "minimum": 0 },
          "instruction": { "type": "string" },
          "outputRequirement": { "type": "string" },
          "skillKey": { "type": ["string", "null"], "minLength": 1 },
          "packageMode": {
            "type": ["string", "null"],
            "enum": ["LEGACY_SYNTHETIC", "FILESYSTEM", null]
          },
          "packageVersion": { "type": ["string", "null"] },
          "packageHash": { "type": ["string", "null"] },
          "capabilityKeys": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/capabilityKey" }
          },
          "entrypoints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "runtime", "script"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "runtime": {
                  "type": "string",
                  "enum": ["pyodide", "python", "node"]
                },
                "script": { "type": "string", "minLength": 1 },
                "description": { "type": ["string", "null"] },
                "inputSchemaJson": { "type": ["string", "null"] },
                "packages": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "capabilityKeys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capabilityKey"
      }
    }
  },
  "$defs": {
    "capabilityKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(builtin:(code_interpreter|data_analysis|deep_search|file|report)|mcp:[A-Za-z0-9_-]+)$"
    }
  }
}
