{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joyagent.local/schemas/tool-binding-view-v1.schema.json",
  "title": "Tool Binding View V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["directCapabilities", "skillCapabilities", "invalidCapabilities"],
  "properties": {
    "directCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capabilityKey" }
    },
    "skillCapabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/capabilityKey" }
      }
    },
    "invalidCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capabilityKey" }
    }
  },
  "$defs": {
    "capabilityKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(builtin:(code_interpreter|data_analysis|deep_search|file|report)|mcp:[A-Za-z0-9_-]+)$"
    }
  }
}
