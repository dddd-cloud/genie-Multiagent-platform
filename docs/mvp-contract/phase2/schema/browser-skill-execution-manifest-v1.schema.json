{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joyagent.local/schemas/browser-skill-execution-manifest-v1.schema.json",
  "title": "Browser Skill Execution Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionId",
    "entrypointName",
    "scriptRelativePath",
    "packages",
    "inputJson"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "executionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "entrypointName": { "type": "string", "minLength": 1, "maxLength": 128 },
    "scriptRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!\\\\)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
    },
    "packages": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
      }
    },
    "inputJson": { "type": "string", "maxLength": 65536 }
  }
}
