{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joyagent.local/schemas/orchestration-trace-v1.schema.json",
  "title": "Orchestration Trace V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sequence",
    "requestId",
    "runId",
    "scope",
    "kind",
    "text",
    "append",
    "truncated"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "string",
      "enum": ["MAIN", "STEP"]
    },
    "attemptNo": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 3
    },
    "stepId": { "type": ["string", "null"] },
    "agentId": { "type": ["string", "null"] },
    "agentName": { "type": ["string", "null"] },
    "kind": {
      "type": "string",
      "enum": ["STATUS", "THOUGHT", "OUTPUT", "ERROR"]
    },
    "text": { "type": "string" },
    "append": { "type": "boolean" },
    "truncated": { "type": "boolean" }
  }
}
