{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JoyAgent Stream Snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["payloadVersion", "truncated", "events"],
  "properties": {
    "payloadVersion": {
      "const": 1
    },
    "truncated": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
