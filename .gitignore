.env
.env.*
!.env.example
results/

# Local env overrides (never commit these)
*.local
.env.local
.env.*.local

# Local package caches and runtime state
node_modules/
**/.pnpm-store/
**/data/
**/uploads/
**/logs/
**/file_db_dir/
*.db
*.sqlite
*.sqlite3

# Session, memory, and local browser state (never commit)
**/session*
**/*.session
**/.joycode/
**/.joyagent/
**/local-memory*
**/opfs-state*

# Per-user Skill Package workspace (never commit); keep skills/builtin/
skills/users/
**/skills/users/

# IDE workspace state (local only)
.vscode/settings.json
.vscode/launch.json
*.code-workspace

# Local toolchain cache (portable Maven/pnpm helpers; never commit)
.tools/

# Local agent/skill cache (machine-specific; never commit)
.agents/

# Local acceptance / scratch artifacts
gate-*.txt
tmp-*
ui/test-results/

# Local acceptance evidence dumps
evidence/**
!evidence/.gitkeep
