# Copy this file to .env and set values for your own environment.
# .env is intentionally ignored. Never commit passwords, tokens, API keys, or local state.

# Required by deploy/docker-compose.mvp.yml
GENIE_DB_USERNAME=genie
GENIE_DB_PASSWORD=<your-mysql-password>
GENIE_BOOTSTRAP_ADMIN_USERNAME=admin
GENIE_BOOTSTRAP_ADMIN_PASSWORD=<your-admin-password>
GENIE_INTERNAL_AGENT_TOKEN=<your-internal-agent-token>
MVP_ACCEPTANCE_USER_PASSWORD=<your-acceptance-user-password>
MVP_ACCEPTANCE_ADMIN_PASSWORD=<your-acceptance-admin-password>

# Real-agent runtime. Use `local` with deploy/docker-compose.real-model.override.yml.
# For the isolated fake-agent acceptance flow, use `mvp-acceptance` instead.
SPRING_PROFILES_ACTIVE=local

# Optional runtime tuning
GENIE_SESSION_TIMEOUT=12h
GENIE_STREAM_SNAPSHOT_MAX_BYTES=8388608
GENIE_HISTORY_MAX_TURNS=6
GENIE_HISTORY_MAX_CHARACTERS=12000
GENIE_SSE_TIMEOUT_MILLIS=3600000
# Optional Skill Package root. Defaults to ./skills when omitted.
GENIE_SKILL_ROOT=./skills
# Optional long-term/short-term memory directory. Defaults to ~/.joyagent/memory.
# Docker Compose mounts ../data/memory -> /var/lib/joyagent/memory.
# GENIE_MEMORY_DIR=

# Phase2 runtime. The credential key must be a base64-encoded 32-byte key.
GENIE_MCP_CREDENTIAL_KEY=<base64-encoded-32-byte-key>
GENIE_INTERNAL_MCP_TOKEN=<your-internal-mcp-token>
VITE_PHASE2_ENABLED=true
# File download/preview base for genie-tool. Must be an absolute URL the browser can open.
# FILE_SERVER_URL=http://127.0.0.1:1601/v1/file_tool

# Pyodide static assets for browser skill execution (official CDN or self-hosted).
# Example: https://cdn.jsdelivr.net/pyodide/v0.27.7/full/
VITE_PYODIDE_INDEX_URL=https://cdn.jsdelivr.net/pyodide/v0.27.7/full/

# Required when deploy/docker-compose.real-model.override.yml is enabled.
DEFAULT_MODEL=qwen3.7-max
OPENAI_BASE_URL=<https://your-openai-compatible-endpoint>
OPENAI_API_KEY=<your-api-key>

# DeepSearch / web search (genie-tool). Serper: https://serper.dev/
USE_JD_SEARCH_GATEWAY=false
USE_SEARCH_ENGINE=serp
SERPER_SEARCH_URL=https://google.serper.dev/search
SERPER_SEARCH_API_KEY=<your-serper-api-key>
# Sidebar titles: semantic summary of the first question, at most 9 Chinese characters.
# Omit this to inherit DEFAULT_MODEL (qwen3.7-max). A failed title call falls back
# to DEFAULT_MODEL, then to a 9-character truncation of the first question.
# GENIE_TITLE_MODEL=qwen3.7-max

# Optional fake-agent acceptance settings. These are only read by the MVP profile.
# MVP_FAKE_AGENT_MODE=SUCCESS
# MVP_FAKE_AGENT_EVENT_COUNT=5
# MVP_FAKE_AGENT_DELAY_MS=50
