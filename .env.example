# Copy this file to .env and replace every empty required value.
# The root .env file is ignored by Git. Never commit real passwords or tokens.

# Required by deploy/docker-compose.mvp.yml
GENIE_DB_USERNAME=genie
GENIE_DB_PASSWORD=
GENIE_BOOTSTRAP_ADMIN_USERNAME=admin
GENIE_BOOTSTRAP_ADMIN_PASSWORD=
GENIE_INTERNAL_AGENT_TOKEN=
MVP_ACCEPTANCE_USER_PASSWORD=MvpTest-Only-123
MVP_ACCEPTANCE_ADMIN_PASSWORD=MvpAdmin-Test-123

# Fake Agent mode (default local acceptance workflow)
SPRING_PROFILES_ACTIVE=mvp-acceptance
MVP_FAKE_AGENT_MODE=SUCCESS
MVP_FAKE_AGENT_EVENT_COUNT=5
MVP_FAKE_AGENT_DELAY_MS=50

# Optional runtime tuning
GENIE_SESSION_TIMEOUT=12h
GENIE_STREAM_SNAPSHOT_MAX_BYTES=8388608
GENIE_HISTORY_MAX_TURNS=6
GENIE_HISTORY_MAX_CHARACTERS=12000
GENIE_SSE_TIMEOUT_MILLIS=3600000

# Required only when deploy/docker-compose.real-model.override.yml is enabled.
# Set SPRING_PROFILES_ACTIVE=local for real-model development.
# DEFAULT_MODEL=
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
